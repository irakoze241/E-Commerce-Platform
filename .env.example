git # ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control!
# ============================================================

# Django core
SECRET_KEY=your-super-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com

# Database (leave blank to use SQLite locally)
# On Render/Railway this is auto-set from the database service
DATABASE_URL=

# SSL redirect (set False only if your host handles SSL termination for you)
SECURE_SSL_REDIRECT=False
